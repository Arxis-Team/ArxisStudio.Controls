<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--
        Галерея показывает контролы в теме «Arxis», поэтому ожидает репозиторий темы
        рядом с этим (тем же соглашением тема ожидает рядом контролы).
    -->
    <PropertyGroup>
        <ThemesRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../ArxisStudio.Themes.Arxis/'))</ThemesRepositoryRoot>
        <ThemesProject>$(ThemesRepositoryRoot)src/ArxisStudio.Themes.Arxis.csproj</ThemesProject>
    </PropertyGroup>

    <!--
        Иконки живут своим репозиторием и ожидаются тем же соглашением: сама
        библиотека контролов набор не зовёт, а карточки галереи показывают
        иконки в кнопках, полях и меню.
    -->
    <PropertyGroup>
        <IconsRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../ArxisStudio.Icons/'))</IconsRepositoryRoot>
        <IconsProject>$(IconsRepositoryRoot)src/ArxisStudio.Icons.csproj</IconsProject>
    </PropertyGroup>

    <Target Name="CheckThemesIsBesideUs" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
        <Error
            Condition="!Exists('$(ThemesProject)')"
            Text="Controls.Gallery показывает контролы в теме ArxisStudio.Themes.Arxis и ожидает этот репозиторий рядом, в '$(ThemesRepositoryRoot)'. Клонируйте его туда." />
        <Error
            Condition="!Exists('$(IconsProject)')"
            Text="Controls.Gallery показывает иконки из ArxisStudio.Icons и ожидает этот репозиторий рядом, в '$(IconsRepositoryRoot)'. Клонируйте его туда." />
    </Target>

    <!--
        Тема Fluent стоит слоем ниже «Arxis» и закрывает те базовые контролы,
        до которых библиотека пока не дошла: своих у неё Ax*-контролы и семь
        базовых типов — ContextMenu, MenuFlyoutPresenter, MenuItem, ScrollBar,
        ScrollViewer, Separator, ToolTip. Когда список закроется целиком,
        Fluent отсюда уйдёт; до тех пор его отсутствие видно не сразу —
        ScrollViewer без темы, например, рисует содержимое и молча теряет
        прокрутку.

        Шрифта здесь нет: ключ AxFontFamily объявлен в теме, оттуда пакет и
        приезжает. Приложению остаётся вызвать WithInterFont().
    -->
    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
    </ItemGroup>

    <!--
        AvaDevTools — дерево элементов, стили, раскладка и конечная точка MCP на
        петле. Оснастка отладочная: в Release её нет, поэтому и ссылка, и весь
        код обращения к ней закрыты условием.

        Порт свой, не студийный: галерея и студия открываются рядом, и один
        порт на двоих означал бы, что подключение достаётся тому, кто успел
        первым.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="AvaDevTools"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Controls.csproj"/>
        <ProjectReference Include="$(ThemesProject)"/>
        <ProjectReference Include="$(IconsProject)"/>
    </ItemGroup>

</Project>
