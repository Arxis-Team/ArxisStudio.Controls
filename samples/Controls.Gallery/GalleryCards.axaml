<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ax="using:ArxisStudio.Controls"
             xmlns:axi="using:ArxisStudio.Icons"
             x:Class="Controls.Gallery.GalleryCards">

  <UserControl.Styles>
    <!--
        Область прокрутки карточки: 110 в высоту, на утопленной подложке —
        та же полоса, что под деревом контролов. Радиус в карточке 6, а в
        шкале его нет (3 / 4 / 8), взят контрольный.
    -->
    <Style Selector="Border.scroll-pane">
      <Setter Property="Height" Value="110"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
      <Setter Property="Background" Value="{DynamicResource AxSurfaceSunkenBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!--
        Значок проекта в полосе окна: 24 на 24 акцентной заливкой, белые буквы.
        Радиус в карточке 6, а в шкале его нет (3 / 4 / 8) — взят контрольный;
        кегль 11 тоже мимо шкалы, взят кегль бейджа.
    -->
    <Style Selector="Border.project-badge">
      <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="Height" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
      <Setter Property="Background" Value="{DynamicResource AxAccentBrush}"/>
    </Style>
    <Style Selector="Border.project-badge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        Виджет запуска: полоса высотой в контрол на подложке первого уровня.
        Радиус в карточке 6 — тот же случай, взят контрольный.
    -->
    <Style Selector="Border.run-widget">
      <Setter Property="Height" Value="{DynamicResource AxControlHeight}"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
      <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.file-badge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource GalleryFileBadgeBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <!--
      Карточки контролов, по одной на контрол. Контрол
      создаётся дважды — в светлой и тёмной половинах окна, — поэтому
      содержимое вынесено в UserControl: правка карточки видна в обеих темах.
      Наведение, нажатие и фокус здесь живые, а не нарисованные: Tab обходит
      карточки с видимым кольцом.
  -->
  <StackPanel Margin="22,18" Spacing="14">

    <!--
        Кнопки — карточка «Button · Primary / Secondary»: два вида по пяти
        состояниям. Наведение, нажатие и фокус проставлены псевдоклассами:
        живое окно показало бы одно состояние за раз, а карточка требует все
        пять сразу.
    -->
    <ax:AxGroupHeader Content="Кнопки"/>
    <Grid ColumnDefinitions="92,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
      <TextBlock Grid.Column="1" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Default" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="2" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Hovered" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="3" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Pressed" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="4" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Focused" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="5" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Disabled" HorizontalAlignment="Center"/>

      <TextBlock Grid.Row="1" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Primary" VerticalAlignment="Center"/>
      <ax:AxButton Grid.Row="1" Grid.Column="1" Appearance="Primary">Button</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="2" x:Name="HoveredPrimary" Appearance="Primary">Button</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="3" x:Name="PressedPrimary" Appearance="Primary">Button</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="4" x:Name="FocusedPrimary" Appearance="Primary">Button</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="5" Appearance="Primary" IsEnabled="False">Button</ax:AxButton>

      <TextBlock Grid.Row="2" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Secondary" VerticalAlignment="Center"/>
      <ax:AxButton Grid.Row="2" Grid.Column="1">Button</ax:AxButton>
      <ax:AxButton Grid.Row="2" Grid.Column="2" x:Name="HoveredSecondary">Button</ax:AxButton>
      <ax:AxButton Grid.Row="2" Grid.Column="3" x:Name="PressedSecondary">Button</ax:AxButton>
      <ax:AxButton Grid.Row="2" Grid.Column="4" x:Name="FocusedSecondary">Button</ax:AxButton>
      <ax:AxButton Grid.Row="2" Grid.Column="5" IsEnabled="False">Button</ax:AxButton>
    </Grid>
    <!--
        Остальные классы кнопки: призрачная, опасная и иконочная.
    -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxButton Appearance="Subtle">Ghost</ax:AxButton>
      <ax:AxButton Appearance="Danger">Delete</ax:AxButton>
      <ax:AxButton Appearance="Toolbar" ToolTip.Tip="Собрать проект">
        <axi:AxIcon Data="{x:Static axi:AxIcons.Plus}"/>
      </ax:AxButton>
    </StackPanel>

    <!-- Компактная кнопка — та же сетка состояний при высоте 24. -->
    <ax:AxGroupHeader Content="Компактная кнопка · 24"/>
    <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
      <TextBlock Grid.Column="0" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Default" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="1" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Hovered" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="2" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Pressed" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="3" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Focused" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="4" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Disabled" HorizontalAlignment="Center"/>

      <ax:AxButton Grid.Row="1" Grid.Column="0" Size="Compact">Slim</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="1" x:Name="HoveredSlim" Size="Compact">Slim</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="2" x:Name="PressedSlim" Size="Compact">Slim</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="3" x:Name="FocusedSlim" Size="Compact">Slim</ax:AxButton>
      <ax:AxButton Grid.Row="1" Grid.Column="4" Size="Compact" IsEnabled="False">Slim</ax:AxButton>
    </Grid>

    <!-- Кнопка с меню -->
    <ax:AxGroupHeader Content="Кнопка с меню"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxSplitButton Appearance="Primary" Content="Run">
        <ax:AxSplitButton.Flyout>
          <ax:AxMenuFlyout>
            <MenuItem Header="Run ChatApp"/>
            <MenuItem Header="Run с отладкой"/>
          </ax:AxMenuFlyout>
        </ax:AxSplitButton.Flyout>
      </ax:AxSplitButton>
      <ax:AxSplitButton Content="Run"/>
      <ax:AxSplitButton Content="Run" IsEnabled="False"/>
    </StackPanel>

    <!-- Дропдаун -->
    <ax:AxGroupHeader Content="Дропдаун"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxDropDownButton Content="Debug">
        <ax:AxDropDownButton.Flyout>
          <ax:AxMenuFlyout>
            <MenuItem Header="Debug"/>
            <MenuItem Header="Release"/>
          </ax:AxMenuFlyout>
        </ax:AxDropDownButton.Flyout>
      </ax:AxDropDownButton>
      <ax:AxDropDownButton Content="Debug" IsEnabled="False"/>
    </StackPanel>

    <!--
        Чекбокс — карточка «Checkbox · 3 типа × 5 состояний»: три типа по
        строкам, состояния по колонкам. Флажки без подписи: карточка показывает
        коробку, а подпись у неё своя, в левой колонке.
    -->
    <ax:AxGroupHeader Content="Чекбокс"/>
    <Grid ColumnDefinitions="104,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
      <TextBlock Grid.Column="1" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Active" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="2" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Hovered" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="3" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Focused" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="4" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Invalid" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="5" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Disabled" HorizontalAlignment="Center"/>

      <TextBlock Grid.Row="1" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Unchecked" VerticalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="1" Grid.Column="2" x:Name="HoveredBox" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="1" Grid.Column="3" x:Name="FocusedBox" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="1" Grid.Column="4" ax:AxValidation.State="Error" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="1" Grid.Column="5" IsEnabled="False" HorizontalAlignment="Center"/>

      <TextBlock Grid.Row="2" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Checked" VerticalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="2" Grid.Column="1" IsChecked="True" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="2" Grid.Column="2" x:Name="HoveredChecked" IsChecked="True" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="2" Grid.Column="3" x:Name="FocusedChecked" IsChecked="True" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="2" Grid.Column="4" ax:AxValidation.State="Error" IsChecked="True" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="2" Grid.Column="5" IsChecked="True" IsEnabled="False" HorizontalAlignment="Center"/>

      <TextBlock Grid.Row="3" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Indeterminate" VerticalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="3" Grid.Column="1" IsThreeState="True" IsChecked="{x:Null}" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="3" Grid.Column="2" x:Name="HoveredMixed" IsThreeState="True" IsChecked="{x:Null}" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="3" Grid.Column="3" x:Name="FocusedMixed" IsThreeState="True" IsChecked="{x:Null}" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="3" Grid.Column="4" ax:AxValidation.State="Error" IsThreeState="True" IsChecked="{x:Null}" HorizontalAlignment="Center"/>
      <ax:AxCheckBox Grid.Row="3" Grid.Column="5" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" HorizontalAlignment="Center"/>
    </Grid>
    <!-- Флажок с подписью: в жизни он ходит с ней, а в карточке её нет. -->
    <ax:AxCheckBox IsChecked="True" Content="Больше не спрашивать"/>

    <!-- Радиокнопка -->
    <ax:AxGroupHeader Content="Радиокнопка"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <ax:AxRadioButton IsChecked="True">On</ax:AxRadioButton>
      <ax:AxRadioButton>Off</ax:AxRadioButton>
      <ax:AxRadioButton IsEnabled="False">Disabled</ax:AxRadioButton>
    </StackPanel>

    <!-- Переключатель -->
    <ax:AxGroupHeader Content="Переключатель · 30×17"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <ax:AxToggleSwitch IsChecked="True" Content="On"/>
      <ax:AxToggleSwitch Content="Off"/>
      <ax:AxToggleSwitch IsChecked="True" IsEnabled="False" Content="Disabled"/>
    </StackPanel>

    <!--
        Поле ввода — карточка «Input Field · с подписью» проекта: пять состояний
        в ряд равными колонками, в колонке подпись состояния, подпись поля и
        само поле.

        Две колонки из пяти показывают фокус, а живое окно даёт один фокус на
        всех — и половин здесь две. Поэтому состояние ставится этим полям прямо,
        тем же псевдоклассом :focus, которым его включает сама тема: карточка
        показывает состояния, а показать состояние значит в него поставить.
        Рисует при этом тема, а не галерея, — своего вида фокуса тут нет.
    -->
    <ax:AxGroupHeader Content="Поле ввода"/>
    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Default"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox Text="ChatView"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Focused"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox x:Name="FocusedField" Text="ChatView"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Invalid"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox ax:AxValidation.State="Error" Text="Chat View!"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Invalid focused"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox x:Name="InvalidFocusedField" ax:AxValidation.State="Error" Text="Chat View!"/>
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Disabled"/>
        <!-- Подпись выключенного поля гаснет вместе с ним: проект даёт AxTextTertiary. -->
        <TextBlock ax:AxText.Tone="Tertiary" Text="Имя формы"/>
        <ax:AxTextBox IsEnabled="False" Text="ChatView"/>
      </StackPanel>
    </Grid>

    <!--
        Остальные виды поля: предупреждение (класс warning рядом с error),
        текст ошибки под полем, подсказка вместо подписи и компактная высота 24.
    -->
    <StackPanel Spacing="8" Width="360" HorizontalAlignment="Left">
      <ax:AxTextBox PlaceholderText="Плейсхолдер читается вместо подписи"/>
      <StackPanel Spacing="3">
        <ax:AxTextBox ax:AxValidation.State="Error" Text="Chat View!"/>
        <TextBlock ax:AxText.Tone="Error" FontSize="11.5" Text="Имя не может содержать пробелы"/>
      </StackPanel>
      <ax:AxTextBox ax:AxValidation.State="Warning" Text="chatview"/>
      <ax:AxTextBox Size="Compact" Text="Компактное · 24"/>
    </StackPanel>

    <!--
        Поиск: поле в
        покое, поле в фокусе с крестиком очистки и строка поиска редактора.

        Строка редактора собрана из готовых контролов: своего контрола под неё
        в библиотеке нет, и заводить его ради витрины незачем.
    -->
    <ax:AxGroupHeader Content="Поиск"/>
    <StackPanel Spacing="14">
      <!--
          Подписи над строками. Карточка проекта их не рисует — там состояния
          различает сам вид, — но живое поле состояние теряет: стёрли текст
          крестиком, и «в фокусе с текстом» стало неотличимо от «в покое».
          Подпись остаётся, что бы с полем ни делали.
      -->
      <StackPanel Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="В покое"/>
        <ax:AxSearchField Width="240" HorizontalAlignment="Left" PlaceholderText="Поиск"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="В фокусе, с очисткой"/>
        <ax:AxSearchField x:Name="FocusedSearch" Width="240" HorizontalAlignment="Left" Text="send"/>
      </StackPanel>

      <!--
          Строка поиска редактора: слева лупа, дальше набранное, справа
          переключатели, счётчик и переходы. Текст здесь настоящий — это поиск,
          в него печатают.
      -->
      <StackPanel Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Строка поиска в редакторе"/>
        <Border Height="32" CornerRadius="6" Padding="10,0"
                Background="{DynamicResource AxSurfacePanelBrush}"
                BorderBrush="{DynamicResource AxStrokeControlBrush}"
                BorderThickness="1">
          <DockPanel LastChildFill="True">
            <axi:AxIcon DockPanel.Dock="Left" Margin="0,0,8,0"
                       Data="{x:Static axi:AxIcons.Search}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <!-- Учитывать регистр включено — своей плашкой; регулярка выключена. -->
              <ax:AxChip Content="Aa" VerticalAlignment="Center"/>
              <TextBlock ax:AxText.Tone="Secondary" Text=".*" VerticalAlignment="Center"/>
              <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="3/14" VerticalAlignment="Center"/>
              <ax:AxButton Appearance="Toolbar" AutomationProperties.Name="Предыдущее">
                <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.ChevronUp}"/>
              </ax:AxButton>
              <ax:AxButton Appearance="Toolbar" AutomationProperties.Name="Следующее">
                <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.ChevronDown}"/>
              </ax:AxButton>
              <ax:AxButton Appearance="Toolbar" AutomationProperties.Name="Закрыть поиск">
                <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.Close}"/>
              </ax:AxButton>
            </StackPanel>
            <ax:AxTextBox Theme="{StaticResource AxInlineTextBox}"
                          Text="message" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- Многострочное поле -->
    <ax:AxGroupHeader Content="Многострочное поле"/>
    <ax:AxTextArea Width="360" HorizontalAlignment="Left"
                   PlaceholderText="Описание, заметка, шаблон письма"/>

    <!-- Комбобокс -->
    <ax:AxGroupHeader Content="Комбобокс"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxComboBox Width="170" SelectedIndex="0">
        <ax:AxComboBoxItem>net8.0-desktop</ax:AxComboBoxItem>
        <ax:AxComboBoxItem>net8.0-android</ax:AxComboBoxItem>
        <ax:AxComboBoxItem>net8.0-ios</ax:AxComboBoxItem>
        <ax:AxComboBoxItem>net8.0-browser</ax:AxComboBoxItem>
      </ax:AxComboBox>
      <ax:AxComboBox Size="Compact" Width="150" SelectedIndex="0">
        <ax:AxComboBoxItem>Компактный · 24</ax:AxComboBoxItem>
      </ax:AxComboBox>
      <ax:AxComboBox Width="130" PlaceholderText="Выключен" IsEnabled="False"/>
    </StackPanel>

    <!-- Сегментированный контрол -->
    <ax:AxGroupHeader Content="Сегментированный контрол"/>
    <ax:AxSegmentedControl SelectedIndex="0">
      <ax:AxSegmentItem>Дизайн</ax:AxSegmentItem>
      <ax:AxSegmentItem>XAML</ax:AxSegmentItem>
      <ax:AxSegmentItem>Разделить</ax:AxSegmentItem>
    </ax:AxSegmentedControl>

    <!-- Вкладки -->
    <ax:AxGroupHeader Content="Вкладки"/>
    <!--
        Два ряда: обычные вкладки прозрачной полосой,
        вкладки документа — на своей, со скруглением сверху и крестиками.

        Оба ряда стоят в панели, и это не украшение витрины. Полоса под выбранной вкладкой красится
        по области выделения: акцентом, пока клавиатура внутри панели, и нейтральной линией, когда
        она ушла. Область объявляет собой панель, вкладки берут признак наследованием — щёлкните по
        вкладке и по чему-нибудь за панелью, и увидите оба цвета.
    -->
    <ax:AxToolWindow ShowHeader="False" Background="Transparent">
      <StackPanel Spacing="8">
        <ax:AxTabStrip Theme="{StaticResource AxToolWindowTabStrip}" SelectedIndex="0"
                       BorderBrush="{DynamicResource AxStrokeSubtleBrush}" BorderThickness="0,0,0,1">
          <ax:AxTabItem Content="Свойства" IsClosable="False"/>
          <ax:AxTabItem Content="События" IsClosable="False"/>
          <ax:AxTabItem Content="Стили" IsClosable="False"/>
          <ax:AxTabItem Content="Ресурсы" IsClosable="False"/>
        </ax:AxTabStrip>
        <ax:AxTabStrip SelectedIndex="0">
          <ax:AxTabItem Content="MainWindow.axaml"/>
          <ax:AxTabItem Content="ChatViewModel.cs" IsModified="True"/>
          <ax:AxTabItem Content="App.axaml"/>
        </ax:AxTabStrip>
      </StackPanel>
    </ax:AxToolWindow>

    <!-- Крошки навигации -->
    <ax:AxGroupHeader Content="Крошки навигации"/>
    <!--
        Путь окна проекта: решение, проект, папки. Последний сегмент — текущее место и никуда не
        ведёт. Второй ряд тот же путь в узкой колонке: ведущие сегменты ушли в меню переполнения у
        левого края, последний остался. Щелчок по сегменту укорачивает путь до него — так владелец
        отвечает на Navigated; сами крошки пути не меняют. «Весь путь» возвращает его целиком.
    -->
    <StackPanel Spacing="8">
      <ax:AxBreadcrumb x:Name="WidePath"/>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <ax:AxBreadcrumb x:Name="NarrowPath" Width="220"/>
        <ax:AxLink Content="Весь путь" Click="OnWholePathClick" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <!-- Ссылки -->
    <ax:AxGroupHeader Content="Ссылки"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <ax:AxLink Content="Документация"/>
      <ax:AxLink Content="Документация" IsVisited="True"/>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <ax:AxLink Content="avaloniaui.net"/>
        <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.ExternalLink}"
                   Foreground="{DynamicResource AxLinkBrush}" VerticalAlignment="Center"/>
      </StackPanel>
      <ax:AxLink Content="Документация" IsEnabled="False"/>
    </StackPanel>

    <!-- Баннеры -->
    <ax:AxGroupHeader Content="Баннеры"/>
    <StackPanel Spacing="8">
      <ax:AxBanner Severity="Information"
                   Content="Доступно обновление Arxis SDK 1.4.2 — новые контролы Avalonia.">
        <ax:AxBanner.Actions>
          <ax:AxLink Content="Обновить"/>
        </ax:AxBanner.Actions>
      </ax:AxBanner>
      <ax:AxBanner Severity="Success"
                   Content="Проект ChatApp успешно собран — 0 ошибок, 0 предупреждений."/>
      <ax:AxBanner Severity="Warning"
                   Content="Не выбран стартовый проект. Запуск недоступен.">
        <ax:AxBanner.Actions>
          <ax:AxLink Content="Выбрать"/>
        </ax:AxBanner.Actions>
      </ax:AxBanner>
      <ax:AxBanner Severity="Error"
                   Content="Ошибка привязки: свойство «UserName» не найдено в ChatViewModel.">
        <ax:AxBanner.Actions>
          <ax:AxLink Content="Показать"/>
        </ax:AxBanner.Actions>
      </ax:AxBanner>
    </StackPanel>

    <!-- Диалоги -->
    <ax:AxGroupHeader Content="Диалоги"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxButton Click="OnOpenDialog">Сохранить изменения?</ax:AxButton>
      <ax:AxButton Click="OnOpenDangerDialog">Удалить форму…</ax:AxButton>
    </StackPanel>

    <!-- Тултипы -->
    <ax:AxGroupHeader Content="Тултипы"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxButton ToolTip.Tip="Собрать проект">Наведи и подожди</ax:AxButton>
      <ax:AxButton>
        <ToolTip.Tip>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Собрать проект"/>
            <TextBlock ax:AxText.Tone="Secondary" Text="⌘ F9"/>
          </StackPanel>
        </ToolTip.Tip>
        С шорткатом
      </ax:AxButton>
    </StackPanel>
    <!--
        Прогресс-бар: определённый с долей справа и бесконечный без неё.
        Подпись идёт основным текстом, доля — вторичным и мельче; ширина блока
        340, как в карточке.
    -->
    <ax:AxGroupHeader Content="Прогресс-бар"/>
    <StackPanel Spacing="18" Width="340" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="62%"/>
          <TextBlock Text="Сборка ChatApp"/>
        </DockPanel>
        <ax:AxProgressBar Minimum="0" Maximum="100" Value="62"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Text="Индексация проекта…"/>
        <ax:AxProgressBar IsIndeterminate="True"/>
      </StackPanel>
    </StackPanel>

    <!-- Лоадер: два размера карточки — 16 вторичным и 24 акцентом. -->
    <ax:AxGroupHeader Content="Лоадер"/>
    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ax:AxSpinner/>
        <TextBlock ax:AxText.Tone="Secondary" VerticalAlignment="Center" Text="Индексация…"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ax:AxSpinner Size="Large"/>
        <TextBlock ax:AxText.Tone="Secondary" VerticalAlignment="Center" Text="Загрузка предпросмотра"/>
      </StackPanel>
    </StackPanel>

    <!-- Контекстное меню -->
    <ax:AxGroupHeader Content="Контекстное меню"/>
    <ax:AxButton x:Name="MenuAnchor" HorizontalAlignment="Left" Click="OnOpenMenu">Открыть меню</ax:AxButton>

    <!-- Попап со списком -->
    <ax:AxGroupHeader Content="Попап поиска"/>
    <ax:AxQuickSearch x:Name="QuickSearch"
                      HorizontalAlignment="Left"
                      Text="chat"
                      SelectedItem="ChatView.axaml · Views"
                      PlaceholderText="Класс, файл, символ"
                      Hints="↑↓ выбор · ↵ открыть · esc"/>

    <!-- Дерево -->
    <ax:AxGroupHeader Content="Дерево"/>
    <!--
        Дерево проекта: у папок и файлов глифы набора. Выбрана строка
        ChatView.axaml.
    -->
    <ax:AxTreeView x:Name="ProjectTree" SelectedItem="{Binding #SelectedFile}">
      <ax:AxTreeViewItem Header="ChatApp" IsExpanded="True" Icon="{x:Static axi:AxIcons.Folder}">
        <ax:AxTreeViewItem Header="Views" IsExpanded="True" Icon="{x:Static axi:AxIcons.Folder}">
          <ax:AxTreeViewItem x:Name="SelectedFile" Header="ChatView.axaml" Icon="{x:Static axi:AxIcons.DocumentCode}"/>
          <ax:AxTreeViewItem Header="MainWindow.axaml" Icon="{x:Static axi:AxIcons.DocumentCode}"/>
        </ax:AxTreeViewItem>
        <ax:AxTreeViewItem Header="ViewModels" Icon="{x:Static axi:AxIcons.Folder}">
          <ax:AxTreeViewItem Header="ChatViewModel.cs"/>
        </ax:AxTreeViewItem>
        <ax:AxTreeViewItem Header="App.axaml" Icon="{x:Static axi:AxIcons.DocumentCode}"/>
      </ax:AxTreeViewItem>
    </ax:AxTreeView>

    <!-- Список: та же строка 24, что и в дереве, но без отступов уровня -->
    <ax:AxGroupHeader Content="Список"/>
    <ax:AxListBox Width="260" HorizontalAlignment="Left" SelectedIndex="1">
      <ax:AxListBoxItem Content="MainWindow.axaml"/>
      <ax:AxListBoxItem Content="ChatView.axaml"/>
      <ax:AxListBoxItem Content="LoginView.axaml"/>
      <ax:AxListBoxItem Content="SettingsView.axaml" IsEnabled="False"/>
    </ax:AxListBox>

    <!-- Таблица -->
    <ax:AxGroupHeader Content="Таблица"/>
    <!--
        Колонки долевые, как в карточке: 2fr 1fr 1fr 1fr. Ширины таблице не
        задаём — в карточке она занимает всю половину.
    -->
    <ax:AxDataGrid x:Name="FilesTable" SelectedIndex="1">
      <ax:AxDataGrid.Header>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="Форма"/>
          <TextBlock Grid.Column="1" Text="Контролов"/>
          <TextBlock Grid.Column="2" Text="Изменена"/>
          <TextBlock Grid.Column="3" Text="Статус"/>
        </Grid>
      </ax:AxDataGrid.Header>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="MainWindow.axaml"/>
          <TextBlock Grid.Column="1" Text="12"/>
          <TextBlock Grid.Column="2" Text="сегодня 14:02"/>
          <TextBlock Grid.Column="3" ax:AxText.Tone="Success" Text="Собрана"/>
        </Grid>
      </ax:AxListBoxItem>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="ChatView.axaml"/>
          <TextBlock Grid.Column="1" Text="23"/>
          <TextBlock Grid.Column="2" Text="сегодня 14:21"/>
          <TextBlock Grid.Column="3" ax:AxText.Tone="Success" Text="Собрана"/>
        </Grid>
      </ax:AxListBoxItem>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="LoginView.axaml"/>
          <TextBlock Grid.Column="1" Text="9"/>
          <TextBlock Grid.Column="2" Text="вчера 18:47"/>
          <TextBlock Grid.Column="3" ax:AxText.Tone="Error" Text="Ошибка привязки"/>
        </Grid>
      </ax:AxListBoxItem>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="SettingsView.axaml"/>
          <TextBlock Grid.Column="1" Text="17"/>
          <TextBlock Grid.Column="2" Text="12 авг"/>
          <TextBlock Grid.Column="3" ax:AxText.Tone="Secondary" Text="Черновик"/>
        </Grid>
      </ax:AxListBoxItem>
    </ax:AxDataGrid>

    <!-- Тулбар -->
    <ax:AxGroupHeader Content="Тулбар"/>
    <!--
        Первый ряд карточки: иконочная кнопка в пяти состояниях и группа из
        трёх. Наведение, нажатие и включённость проставлены псевдоклассами —
        живое окно показало бы одно состояние за раз.

        Кнопка идёт 24 на 24: столько объявляет тема у иконочной AxButton.
    -->
    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <ax:AxButton Appearance="Toolbar" HorizontalAlignment="Center">
          <axi:AxIcon Data="{x:Static axi:AxIcons.Plus}"/>
        </ax:AxButton>
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Default" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <ax:AxButton x:Name="HoveredTool" Appearance="Toolbar" HorizontalAlignment="Center">
          <axi:AxIcon Data="{x:Static axi:AxIcons.Plus}"/>
        </ax:AxButton>
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Hovered" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <ax:AxButton x:Name="PressedTool" Appearance="Toolbar" HorizontalAlignment="Center">
          <axi:AxIcon Data="{x:Static axi:AxIcons.Plus}"/>
        </ax:AxButton>
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Pressed" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <ax:AxToggleButton x:Name="SelectedTool" Appearance="Toolbar" IsChecked="True" HorizontalAlignment="Center">
          <axi:AxIcon Data="{x:Static axi:AxIcons.List}"/>
        </ax:AxToggleButton>
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Selected" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <ax:AxButton Appearance="Toolbar" IsEnabled="False" HorizontalAlignment="Center">
          <axi:AxIcon Data="{x:Static axi:AxIcons.Plus}"/>
        </ax:AxButton>
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Disabled" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Разделитель группы: 1 на 22 цветом рамки. -->
      <ax:AxDivider Orientation="Vertical" Height="22"/>

      <StackPanel Orientation="Horizontal" Spacing="2">
        <ax:AxButton Appearance="Toolbar" ToolTip.Tip="Свернуть всё">
          <axi:AxIcon Data="{x:Static axi:AxIcons.Minus}"/>
        </ax:AxButton>
        <ax:AxButton Appearance="Toolbar" ToolTip.Tip="Фильтр">
          <axi:AxIcon Data="{x:Static axi:AxIcons.Filter}"/>
        </ax:AxButton>
        <ax:AxButton Appearance="Toolbar" ToolTip.Tip="Ещё">
          <axi:AxIcon Data="{x:Static axi:AxIcons.MoreHorizontal}"/>
        </ax:AxButton>
      </StackPanel>
    </StackPanel>

    <!--
        Второй ряд: полоса окна целиком — проект, ветка, конфигурация, виджет
        запуска и кнопки окна. Отдельного системного заголовка у главного
        окна нет, эта полоса и есть заголовок.

        Кнопки окна тут не принимают нажатий: свои кнопки полоса вешает на то
        окно, в котором стоит, и в галерее «закрыть» закрыло бы саму галерею.
        Карточка показывает вид, а не поведение.
    -->
    <ax:AxTitleBar ShowWindowControls="False">
      <ax:AxToolBar Margin="12,0">
        <ax:AxToolBar.LeftContent>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Classes="project-badge"><TextBlock Text="Ax"/></Border>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="ВолнаЧат" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.ChevronDown}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <axi:AxIcon Data="{x:Static axi:AxIcons.Branch}"/>
              <TextBlock ax:AxText.Tone="Secondary" Text="main" VerticalAlignment="Center"/>
              <TextBlock ax:AxText.Tone="Secondary" Text="↑2" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock ax:AxText.Tone="Secondary" Text="Desktop · Debug" VerticalAlignment="Center"/>
              <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.ChevronDown}"/>
            </StackPanel>
          </StackPanel>
        </ax:AxToolBar.LeftContent>
        <ax:AxToolBar.RightContent>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <axi:AxIcon Data="{x:Static axi:AxIcons.Search}"/>
            <!--
                Виджет запуска: конфигурация, которую сейчас запустят. Своего
                контрола под него проект не заводит, поэтому он собран здесь.
            -->
            <Border Classes="run-widget">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <axi:AxIcon Data="{x:Static axi:AxIcons.Play}"
                           Foreground="{DynamicResource AxSuccessBrush}"/>
                <axi:AxIcon Data="{x:Static axi:AxIcons.Refresh}"/>
                <TextBlock Text="ВолнаЧат.Desktop" VerticalAlignment="Center"/>
                <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.ChevronDown}"/>
              </StackPanel>
            </Border>
            <axi:AxIcon Data="{x:Static axi:AxIcons.Split}"/>
            <!-- Разделитель внутри полосы — того же веса, что линии снаружи неё. -->
            <ax:AxDivider Orientation="Vertical" Height="20"/>
            <ax:AxWindowControls IsHitTestVisible="False"/>
          </StackPanel>
        </ax:AxToolBar.RightContent>
      </ax:AxToolBar>
    </ax:AxTitleBar>

    <!--
        Тулбар окна: отдельного системного заголовка у главного окна
        нет — строка с проектом и есть заголовок.

        Кнопки окна тут стоят отдельным AxWindowControls и не принимают
        нажатий: свои кнопки полоса вешает на то окно, в котором стоит, и в
        галерее «закрыть» закрыло бы саму галерею. Карточка показывает вид,
        а не поведение.
    -->
    <ax:AxGroupHeader Content="Тулбар окна"/>
    <ax:AxTitleBar Width="520" HorizontalAlignment="Left" ShowWindowControls="False">
      <DockPanel Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <axi:AxIcon Data="{x:Static axi:AxIcons.Window}"/>
          <TextBlock Text="ВолнаЧат" VerticalAlignment="Center"/>
          <ax:AxChip Content="Debug"/>
        </StackPanel>
        <ax:AxWindowControls DockPanel.Dock="Right" IsHitTestVisible="False"/>
        <Panel/>
      </DockPanel>
    </ax:AxTitleBar>

    <!-- Tool Window -->
    <ax:AxGroupHeader Content="Tool Window"/>
    <!--
        Три вида шапки рядом, как в карточке: только заголовок, заголовок с
        линией, заголовок с вкладками. Панели пустые — карточка показывает
        именно шапку, а содержимое там ничем не занято.
    -->
    <!--
        Правило карточки — колонки делят строку поровну и переносятся, когда
        каждой остаётся меньше 250. На половине витрины в 736 три колонки дали
        бы по 232, поэтому их две, и третья панель встаёт на вторую строку.
        Отбивка 20 висит на самих колонках, а отрицательное поле сетки убирает
        её с внешних краёв.
    -->
    <UniformGrid Columns="2" Margin="0,0,-20,-20">
      <StackPanel Spacing="8" Margin="0,0,20,20">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Label only"/>
        <ax:AxToolWindow Title="Header" Height="150" ShowHeaderSeparator="False">
          <ax:AxToolWindow.Actions>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton Appearance="Toolbar">
                <axi:AxIcon Data="{x:Static axi:AxIcons.MoreVertical}"/>
              </ax:AxButton>
              <ax:AxButton Appearance="Toolbar">
                <axi:AxIcon Data="{x:Static axi:AxIcons.Minus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Actions>
        </ax:AxToolWindow>
      </StackPanel>

      <StackPanel Spacing="8" Margin="0,0,20,20">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Label with separator"/>
        <ax:AxToolWindow Title="Header" Height="150" ShowHeaderSeparator="True">
          <ax:AxToolWindow.Actions>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton Appearance="Toolbar">
                <axi:AxIcon Data="{x:Static axi:AxIcons.MoreVertical}"/>
              </ax:AxButton>
              <ax:AxButton Appearance="Toolbar">
                <axi:AxIcon Data="{x:Static axi:AxIcons.Minus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Actions>
        </ax:AxToolWindow>
      </StackPanel>

      <StackPanel Spacing="8" Margin="0,0,20,20">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Tabs"/>
        <ax:AxToolWindow Title="Header" Height="150" ShowHeaderSeparator="True">
          <ax:AxToolWindow.Tabs>
            <StackPanel Orientation="Horizontal">
              <ax:AxTabStrip Theme="{StaticResource AxToolWindowTabStrip}" SelectedIndex="0">
                <ax:AxTabItem Content="Text"/>
                <ax:AxTabItem Content="Text"/>
              </ax:AxTabStrip>
              <!-- Добавить вкладку: в карточке кнопка стоит в ряду вкладок. -->
              <ax:AxButton Appearance="Toolbar" VerticalAlignment="Center">
                <axi:AxIcon Data="{x:Static axi:AxIcons.Plus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Tabs>
          <ax:AxToolWindow.Actions>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton Appearance="Toolbar">
                <axi:AxIcon Data="{x:Static axi:AxIcons.MoreVertical}"/>
              </ax:AxButton>
              <ax:AxButton Appearance="Toolbar">
                <axi:AxIcon Data="{x:Static axi:AxIcons.Minus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Actions>
        </ax:AxToolWindow>
      </StackPanel>
    </UniformGrid>

    <!-- Скроллбар -->
    <ax:AxGroupHeader Content="Скроллбар"/>
    <!--
        Две области рядом, как в карточке: в покое и под курсором. Разворот
        второй проставлен псевдоклассом — курсор в живом окне один, а карточка
        показывает оба состояния сразу. Горизонтальная полоса в карточке видна
        только у развёрнутой, поэтому содержимое второй шире области.
    -->
    <UniformGrid Columns="2" Margin="0,0,-24,0">
      <Border Classes="scroll-pane" Margin="0,0,24,0">
        <ScrollViewer VerticalScrollBarVisibility="Visible">
          <StackPanel Margin="10">
            <TextBlock ax:AxText.Tone="Secondary" Text="Default"/>
            <TextBlock Text="Строка 2"/><TextBlock Text="Строка 3"/>
            <TextBlock Text="Строка 4"/><TextBlock Text="Строка 5"/>
            <TextBlock Text="Строка 6"/><TextBlock Text="Строка 7"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Classes="scroll-pane" Margin="0,0,24,0">
        <ScrollViewer x:Name="ExpandedScroll"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Visible">
          <StackPanel Margin="10">
            <TextBlock ax:AxText.Tone="Secondary" Text="Hovered"/>
            <TextBlock Text="Строка 2"/><TextBlock Text="Строка 3"/>
            <TextBlock Text="Строка 4"/><TextBlock Text="Строка 5"/>
            <TextBlock Text="Строка 6, которая не помещается по ширине области"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </UniformGrid>

    <!-- Шорткаты и код -->
    <ax:AxGroupHeader Content="Шорткаты и код"/>
    <!--
        Строка шортката карточки: подпись, сочетание клавиш и второе через
        косую черту. Разделитель идёт на AxTextTertiary — это токен шорткатов и декора,
        и читаемым текстом он не служит.
    -->
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <TextBlock ax:AxText.Tone="Secondary" Text="Собрать и запустить" VerticalAlignment="Center"/>
      <ax:AxChip Kind="Key">⌘</ax:AxChip>
      <ax:AxChip Kind="Key">R</ax:AxChip>
      <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Tertiary" Text="/" VerticalAlignment="Center"/>
      <ax:AxChip Kind="Key">Shift F10</ax:AxChip>
    </StackPanel>
    <ax:AxCodeBlock x:Name="Code"/>

    <!--
        Чипы и бейджи: контролы есть, и витрина обязана показать каждый.
    -->
    <ax:AxGroupHeader Content="Чипы и бейджи"/>
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ax:AxChip>метка</ax:AxChip>
      <ax:AxChip Kind="Accent">выбранная</ax:AxChip>
      <ax:AxBadge>7</ax:AxBadge>
    </StackPanel>

    <!-- Заголовок группы -->
    <ax:AxGroupHeader Content="Заголовок группы"/>
    <!--
        Три заголовка карточки: обычный, сворачиваемый раскрытый со счётчиком и
        сворачиваемый свёрнутый.
    -->
    <StackPanel Spacing="16">
      <ax:AxGroupHeader Content="Внешний вид"/>
      <ax:AxGroupHeader Content="Привязки" IsCollapsible="True" Counter="3"/>
      <ax:AxGroupHeader Content="Дополнительно" IsCollapsible="True" IsExpanded="False"/>
    </StackPanel>

    <!--
        Разделители: линия в пиксель в обеих ориентациях цвета AxStrokeSubtle. Живьём
        разделители видно в тулбаре, в таблице и под шапкой панели.
    -->
    <ax:AxGroupHeader Content="Разделители"/>
    <StackPanel Spacing="10">
      <ax:AxDivider Width="260" HorizontalAlignment="Left"/>
      <StackPanel Orientation="Horizontal" Spacing="10" Height="20">
        <TextBlock ax:AxText.Tone="Secondary" Text="слева" VerticalAlignment="Center"/>
        <ax:AxDivider Orientation="Vertical"/>
        <TextBlock ax:AxText.Tone="Secondary" Text="справа" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <!--
        Разделитель областей: линия та же, что у AxDivider, но за неё можно
        взяться. Карточка показывает обе стороны живьём — потянуть их мышью и
        есть единственная проверка, которую разделителю имеет смысл устраивать.
    -->
    <ax:AxGroupHeader Content="Разделитель областей"/>
    <StackPanel Orientation="Horizontal" Spacing="16" Height="120">

      <Border Width="300" BorderThickness="1" BorderBrush="{DynamicResource AxStrokeSubtleBrush}">
        <Grid ColumnDefinitions="*,Auto,*">
          <TextBlock Grid.Column="0" ax:AxText.Tone="Secondary" Text="слева"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ax:AxSplitter Grid.Column="1" Orientation="Vertical"/>
          <TextBlock Grid.Column="2" ax:AxText.Tone="Secondary" Text="справа"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Width="300" BorderThickness="1" BorderBrush="{DynamicResource AxStrokeSubtleBrush}">
        <Grid RowDefinitions="*,Auto,*">
          <TextBlock Grid.Row="0" ax:AxText.Tone="Secondary" Text="сверху"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ax:AxSplitter Grid.Row="1" Orientation="Horizontal"/>
          <TextBlock Grid.Row="2" ax:AxText.Tone="Secondary" Text="снизу"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>

    </StackPanel>

    <!--
        Примитивы: аватар, ползунок, разделитель и карточка-контейнер. Решение
        про цветные монограммы показано отдельной строкой.
    -->
    <ax:AxGroupHeader Content="Примитивы"/>
    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
      <ax:AxAvatar Initials="ВЧ"/>
      <ax:AxAvatar Shape="Circle" Initials="МК"/>
      <ax:AxSlider Width="140" Minimum="0" Maximum="100" Value="60"/>
      <ax:AxDivider Orientation="Vertical" Height="20"/>
      <ax:AxCard Padding="10">
        <TextBlock ax:AxText.Tone="Secondary" FontSize="11.5" Text="Карточка"/>
      </ax:AxCard>
    </StackPanel>
    <!--
        Цветные монограммы не ставят на AxTintOrange / AxSuccess / AxTintPurple / AxError — белые
        инициалы дают там в тёмной теме 2,50…3,44:1.
    -->
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <ax:AxAvatar Tint="Orange" Initials="Ор"/>
      <ax:AxAvatar Tint="Green" Initials="Зл"/>
      <ax:AxAvatar Tint="Purple" Initials="Фл"/>
      <ax:AxAvatar Tint="Red" Initials="Кр"/>
    </StackPanel>

  </StackPanel>
</UserControl>
