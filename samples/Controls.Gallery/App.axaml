<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:ArxisStudio.Themes.Arxis"
             x:Class="Controls.Gallery.App"
             RequestedThemeVariant="Dark">
  <!-- Одна тема студии: окно, попапы и простые контейнеры она одевает сама. -->
  <Application.Styles>
    <themes:ArxisTheme/>
  </Application.Styles>
</Application>
