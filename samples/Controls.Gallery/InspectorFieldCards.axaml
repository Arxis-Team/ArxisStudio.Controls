<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ax="using:ArxisStudio.Controls"
             xmlns:axi="using:ArxisStudio.Icons"
             xmlns:sys="using:System"
             xmlns:local="using:Controls.Gallery"
             x:Class="Controls.Gallery.InspectorFieldCards">

  <!--
      Поля инспектора — отдельным файлом рядом с основными карточками: число с протяжкой, подпись,
      за которую его тянут, вектор, строка свойства и жетоны. Внизу — маленький инспектор из них,
      и строка под ним говорит, что зафиксировано последним: протяжка видна на ходу, а фиксируется
      одна, при отпускании.
  -->
  <UserControl.Resources>
    <!-- Строка списка шрифтов — имя, написанное своим шрифтом. -->
    <DataTemplate x:Key="FontSample" x:DataType="sys:String">
      <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Margin="22,0,22,18" Spacing="14">

    <!--
        Число: покой, каретка в поле, разные значения у выбранных, «авто», ошибка, выключенное и
        только для чтения. Подпись слева тянет число: курсор — стрелки, Shift быстрее, Alt тоньше,
        Esc возвращает прежнее.
    -->
    <ax:AxGroupHeader Content="Число"/>
    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="12">
      <StackPanel Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Default"/>
        <ax:AxNumberField Size="Compact" Value="128"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Focused"/>
        <ax:AxNumberField x:Name="FocusedNumber" Size="Compact" Value="12.5"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Mixed"/>
        <ax:AxNumberField Size="Compact" Value="4" IsMixed="True"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Auto"/>
        <ax:AxNumberField Size="Compact" AllowsAuto="True" Value="{x:Static sys:Double.NaN}"/>
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Invalid"/>
        <ax:AxNumberField Size="Compact" Value="3" ax:AxValidation.State="Error"/>
      </StackPanel>
      <StackPanel Grid.Column="5" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Disabled"/>
        <ax:AxNumberField Size="Compact" Value="64" IsEnabled="False"/>
      </StackPanel>
      <StackPanel Grid.Column="6" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Read-only"/>
        <ax:AxTextBox Size="Compact" Text="Button" IsReadOnly="True"/>
      </StackPanel>
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <ax:AxScrubLabel Content="Opacity" Target="{Binding #ScrubbedNumber}" VerticalAlignment="Center"/>
      <ax:AxNumberField x:Name="ScrubbedNumber" Size="Compact" Width="96"
                        Minimum="0" Maximum="1" Step="0.1" Decimals="2" Value="0.85"/>
    </StackPanel>

    <!--
        Вектор: отступ с переключателем «одинаково со всех сторон», точка, расходящаяся
        составляющая и тот же отступ в узкой колонке — ячейки переносятся поровну.
    -->
    <ax:AxGroupHeader Content="Вектор"/>
    <StackPanel Spacing="10">
      <ax:AxVectorField Size="Compact" Width="420" HorizontalAlignment="Left" CanLink="True"
                        Labels="{x:Static local:InspectorFieldCards.Sides}" Values="{x:Static local:InspectorFieldCards.Offsets}"/>
      <ax:AxVectorField Size="Compact" Width="260" HorizontalAlignment="Left"
                        Labels="{x:Static local:InspectorFieldCards.Axes}" Values="{x:Static local:InspectorFieldCards.Location}"
                        MixedMask="2"/>
      <ax:AxVectorField Size="Compact" Width="150" HorizontalAlignment="Left" CanLink="True" IsLinked="True"
                        Labels="{x:Static local:InspectorFieldCards.Sides}" Values="{x:Static local:InspectorFieldCards.Uniform}"/>
    </StackPanel>

    <!--
        Число в границах — ползунок и поле рядом, как Range у Unity: дробное с шагом 0.01, целое, разные значения
        и только для чтения. Ползунок тянут и щёлкают по дорожке, клавиши шагают; протянутое видно в поле, а
        фиксируется одно значение — при отпускании.
    -->
    <ax:AxGroupHeader Content="Число в границах"/>
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="0…1, step 0.01"/>
        <ax:AxRangeField Size="Compact" Minimum="0" Maximum="1" Step="0.01" Decimals="2" Value="0.85"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="0…10, whole"/>
        <ax:AxRangeField Size="Compact" Minimum="0" Maximum="10" Step="1" Decimals="0" Value="4"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Mixed"/>
        <ax:AxRangeField Size="Compact" Minimum="0" Maximum="1" Step="0.01" Decimals="2" Value="0.3" IsMixed="True"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Read-only"/>
        <ax:AxRangeField Size="Compact" Minimum="0" Maximum="1" Step="0.01" Decimals="2" Value="0.5" IsReadOnly="True"/>
      </StackPanel>
    </Grid>

    <!--
        Жетоны: пустое поле с подсказкой, классы стиля и то же только для чтения. Пробел или запятая
        заканчивают жетон, Backspace в пустой строке встаёт на последний, второй — снимает его.
    -->
    <ax:AxGroupHeader Content="Жетоны"/>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
      <ax:AxTokenField Size="Compact" PlaceholderText="Классы стиля"/>
      <ax:AxTokenField Grid.Column="1" Size="Compact" Tokens="{x:Static local:InspectorFieldCards.StyleClasses}"/>
      <ax:AxTokenField Grid.Column="2" Size="Compact" IsReadOnly="True" Tokens="{x:Static local:InspectorFieldCards.StyleClasses}"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ax:AxChip Content="primary" IsRemovable="True"/>
      <ax:AxChip Content="large" IsRemovable="True"/>
      <ax:AxChip Content="Accent" Kind="Accent" IsRemovable="True"/>
    </StackPanel>

    <!--
        Шрифт — список, в который можно набрать своё (IsEditable): каждое имя написано своим шрифтом, а каретка в поле
        зажигает рамку и кольцо всего списка, как у поля жетонов. Покой, каретка в поле и выключенное.
    -->
    <ax:AxGroupHeader Content="Шрифт"/>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Editable"/>
        <ax:AxComboBox Size="Compact" IsEditable="True" HorizontalAlignment="Stretch" Text="Segoe UI"
                       ItemsSource="{x:Static local:InspectorFieldCards.Fonts}" ItemTemplate="{StaticResource FontSample}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Editing"/>
        <ax:AxComboBox x:Name="EditingFont" Size="Compact" IsEditable="True" HorizontalAlignment="Stretch" Text="Consolas"
                       ItemsSource="{x:Static local:InspectorFieldCards.Fonts}" ItemTemplate="{StaticResource FontSample}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Disabled"/>
        <ax:AxComboBox Size="Compact" IsEditable="True" HorizontalAlignment="Stretch" Text="Georgia" IsEnabled="False"
                       ItemsSource="{x:Static local:InspectorFieldCards.Fonts}" ItemTemplate="{StaticResource FontSample}"/>
      </StackPanel>
    </Grid>

    <!--
        Цвет: поле, как у Unity, — полоса цвета с полоской прозрачности и пипетка, — прозрачный цвет, разные
        значения, только для чтения, без прозрачности и «нет цвета». Щелчок по полосе открывает окно «Цвет»;
        справа его выбор открытым: пипетка и образцы «стало | было», кольцо оттенков с квадратом, вид каналов,
        ползунки каналов с числами и код. Ниже — сам образец: полоской прозрачности, шахматкой и «нет цвета».
    -->
    <ax:AxGroupHeader Content="Цвет"/>
    <Grid ColumnDefinitions="*,24,Auto">
      <StackPanel Spacing="8">
        <ax:AxColorField Size="Compact" Color="#3C6ECF"/>
        <ax:AxColorField Size="Compact" Color="#803C6ECF"/>
        <ax:AxColorField Size="Compact" Color="#3C6ECF" IsMixed="True"/>
        <ax:AxColorField Size="Compact" Color="#E0A040" IsReadOnly="True"/>
        <ax:AxColorField Size="Compact" Color="#20A060" AllowsAlpha="False"/>
        <ax:AxColorField Size="Compact" IsNone="True"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ax:AxColorSwatch Width="48" Height="20" Color="#803C6ECF"/>
          <ax:AxColorSwatch Width="48" Height="20" Color="#803C6ECF" AlphaDisplay="Checker"/>
          <ax:AxColorSwatch Width="48" Height="20" IsNone="True"/>
        </StackPanel>
        <!--
            Части выбора по отдельности: кольцо оттенков, спектр и ползунки любого канала — и RGB — берут цвет
            моделью HSV.
        -->
        <StackPanel Orientation="Horizontal" Spacing="16">
          <ax:AxColorWheel Width="96" Height="96" Hsv="hsv(150, 70%, 80%)"/>
          <ax:AxColorSpectrum Width="160" Height="96" Hsv="hsv(150, 70%, 80%)"/>
          <StackPanel Width="200" Spacing="10" VerticalAlignment="Center">
            <ax:AxColorSlider Channel="Red" Hsv="hsv(150, 70%, 80%)"/>
            <ax:AxColorSlider Channel="Saturation" Hsv="hsv(150, 70%, 80%)"/>
            <ax:AxColorSlider Channel="Value" Hsv="hsv(150, 70%, 80%)"/>
            <ax:AxColorSlider Channel="Alpha" Hsv="hsv(150, 70%, 80%)"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="2" Background="{DynamicResource AxSurfaceOverlayBrush}"
              BorderBrush="{DynamicResource AxStrokeControlBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource AxCornerRadiusLarge}" Padding="12">
        <ax:AxColorPicker Color="#C04B8DE0"/>
      </Border>
    </Grid>

    <!--
        Строки свойства — маленький инспектор. Колонка подписей одна на список, вложенные строки
        съедают подпись, а не сдвигают поле; заданное здесь — полужирная подпись;
        только для чтения — подпись вторичная и значение выделяемым текстом; ошибка — заметкой под
        полем. Разделы — полосами компонентов, как у Unity: стрелка, значок, имя, счётчик заданного
        и ⋮ справа. Справа тот же список в узкой колонке: полям тесно, и они уходят под подписи.
    -->
    <ax:AxGroupHeader Content="Строка свойства"/>
    <Grid ColumnDefinitions="420,24,260">
      <Border Background="{DynamicResource AxSurfacePanelBrush}" CornerRadius="{DynamicResource AxCornerRadius}" Padding="8">
        <StackPanel x:Name="Inspector" Spacing="2">
          <ax:AxPropertyRow Label="Name" IsReadOnly="True">
            <ax:AxTextBox Size="Compact" Text="SaveButton" IsReadOnly="True"/>
          </ax:AxPropertyRow>
          <ax:AxGroupHeader Content="Макет" Appearance="Band" IsCollapsible="True" Counter="2"
                            Icon="{x:Static axi:AxIcons.Grid}">
            <ax:AxGroupHeader.Actions>
              <ax:AxButton Appearance="Toolbar" Size="Compact" AutomationProperties.Name="Действия с разделом">
                <axi:AxIcon Data="{x:Static axi:AxIcons.MoreVertical}"/>
                <ax:AxButton.Flyout>
                  <ax:AxMenuFlyout>
                    <ax:AxMenuItem Header="Сбросить раздел"/>
                    <ax:AxMenuItem Header="Копировать значения раздела"/>
                    <ax:AxMenuItem Header="Вставить значения"/>
                  </ax:AxMenuFlyout>
                </ax:AxButton.Flyout>
              </ax:AxButton>
            </ax:AxGroupHeader.Actions>
          </ax:AxGroupHeader>
          <ax:AxPropertyRow x:Name="WidthRow" Label="Width" IsOverridden="True" ScrubTarget="{Binding #WidthField}">
            <ax:AxPropertyRow.Actions>
              <ax:AxButton Appearance="Toolbar" AutomationProperties.Name="Действия со свойством"
                           Width="{DynamicResource AxControlHeightCompact}" Height="{DynamicResource AxControlHeightCompact}">
                <axi:AxIcon Size="Small" Data="{x:Static axi:AxIcons.MoreVertical}"/>
                <ax:AxButton.Flyout>
                  <ax:AxMenuFlyout>
                    <ax:AxMenuItem Header="Сбросить"/>
                    <ax:AxMenuItem Header="Копировать значение"/>
                    <ax:AxMenuItem Header="Вставить значение"/>
                    <ax:AxSeparator/>
                    <ax:AxMenuItem Header="Показать в XAML"/>
                  </ax:AxMenuFlyout>
                </ax:AxButton.Flyout>
              </ax:AxButton>
            </ax:AxPropertyRow.Actions>
            <ax:AxNumberField x:Name="WidthField" Size="Compact" AllowsAuto="True" Minimum="0" Value="120"/>
          </ax:AxPropertyRow>
          <ax:AxPropertyRow Label="Height" ScrubTarget="{Binding #HeightField}">
            <ax:AxNumberField x:Name="HeightField" Size="Compact" AllowsAuto="True" Minimum="0"
                              Value="{x:Static sys:Double.NaN}"/>
          </ax:AxPropertyRow>
          <ax:AxPropertyRow Label="Margin" IsOverridden="True">
            <ax:AxVectorField Size="Compact" CanLink="True"
                              Labels="{x:Static local:InspectorFieldCards.Sides}" Values="{x:Static local:InspectorFieldCards.Offsets}"/>
          </ax:AxPropertyRow>
          <ax:AxPropertyRow Label="Left" Indent="1" ScrubTarget="{Binding #LeftField}">
            <ax:AxNumberField x:Name="LeftField" Size="Compact" Value="8"/>
          </ax:AxPropertyRow>
          <ax:AxGroupHeader Content="Вид" Appearance="Band" IsCollapsible="True" Counter="1"
                            Icon="{x:Static axi:AxIcons.Preview}"/>
          <ax:AxPropertyRow Label="Opacity" ScrubTarget="{Binding #OpacityField}" ax:AxValidation.State="Error"
                            Note="Прозрачность — от 0 до 1">
            <ax:AxNumberField x:Name="OpacityField" Size="Compact" Minimum="0" Maximum="1" Step="0.1"
                              Value="1" ax:AxValidation.State="Error"/>
          </ax:AxPropertyRow>
          <ax:AxPropertyRow Label="Background" IsOverridden="True">
            <ax:AxColorField Size="Compact" Color="#2B3A55"/>
          </ax:AxPropertyRow>
          <ax:AxPropertyRow Label="Is Enabled">
            <ax:AxCheckBox IsChecked="True"/>
          </ax:AxPropertyRow>
          <ax:AxPropertyRow Label="Classes" Layout="Below">
            <ax:AxTokenField Size="Compact" Tokens="{x:Static local:InspectorFieldCards.StyleClasses}"/>
          </ax:AxPropertyRow>
          <TextBlock x:Name="LastCommit" ax:AxText.Role="Small" ax:AxText.Tone="Secondary" Text="Фиксаций пока нет"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource AxSurfacePanelBrush}" CornerRadius="{DynamicResource AxCornerRadius}" Padding="8"
              VerticalAlignment="Top">
        <StackPanel Spacing="2">
          <ax:AxPropertyRow Label="Horizontal Content Alignment" IsOverridden="True">
            <ax:AxTextBox Size="Compact" Text="Stretch"/>
          </ax:AxPropertyRow>
          <ax:AxPropertyRow Label="Padding">
            <ax:AxVectorField Size="Compact"
                              Labels="{x:Static local:InspectorFieldCards.Sides}" Values="{x:Static local:InspectorFieldCards.Offsets}"/>
          </ax:AxPropertyRow>
        </StackPanel>
      </Border>
    </Grid>

  </StackPanel>
</UserControl>
