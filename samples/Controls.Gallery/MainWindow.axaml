<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="using:ArxisStudio.Controls"
        xmlns:g="using:Controls.Gallery"
        x:Class="Controls.Gallery.MainWindow"
        Title="ArxisStudio.Controls — Gallery"
        Width="1560" Height="900">

  <!--
      Галерея повторяет страницу «20 Контролы» дизайн-проекта: одни и те же
      карточки в светлой и тёмной половинах рядом — темы задают
      ThemeVariantScope, поэтому сверка с design/20 Controls.dc.html идёт
      на одном экране. Наведение, нажатие и Tab-фокус живые.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource AxBg2Brush}"
            BorderBrush="{DynamicResource AxBrdBrush}"
            BorderThickness="0,0,0,1"
            Padding="22,10">
      <DockPanel>
        <ax:AxSegmentedControl x:Name="PanelsSwitch" DockPanel.Dock="Right"
                               SelectionChanged="OnPanelsChanged">
          <ax:AxSegmentItem>Обе</ax:AxSegmentItem>
          <ax:AxSegmentItem>Light</ax:AxSegmentItem>
          <ax:AxSegmentItem>Dark</ax:AxSegmentItem>
        </ax:AxSegmentedControl>
        <StackPanel>
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="ArxisStudio.Controls"/>
          <TextBlock Classes="dim" FontSize="11.5"
                     Text="Галерея: каждая карточка страницы «Контролы» в Light и Dark"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer>
      <Grid ColumnDefinitions="*,*">
        <ThemeVariantScope x:Name="LightHalf" RequestedThemeVariant="Light">
          <Border Background="{DynamicResource AxBg1Brush}">
            <g:GalleryCards/>
          </Border>
        </ThemeVariantScope>
        <ThemeVariantScope x:Name="DarkHalf" Grid.Column="1" RequestedThemeVariant="Dark">
          <Border Background="{DynamicResource AxBg1Brush}">
            <g:GalleryCards/>
          </Border>
        </ThemeVariantScope>
      </Grid>
    </ScrollViewer>
  </DockPanel>

</Window>
