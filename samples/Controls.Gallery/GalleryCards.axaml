<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ax="using:ArxisStudio.Controls"
             x:Class="Controls.Gallery.GalleryCards">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!--
            Буквы на плашке типа файла. Своего ключа у этого цвета в проекте
            нет: плашка живёт только внутри карточки дерева, и там взяты
            AxBlue4 в светлой и AxBlue10 в тёмной. Через AxAcc не выразить —
            в тёмной он остаётся #3574F0 и на AxInfoBackground не читается.
        -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="GalleryFileBadgeBrush" Color="{StaticResource AxBlue4}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="GalleryFileBadgeBrush" Color="{StaticResource AxBlue10}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--
        Плашка типа файла: карточка проекта ставит её слева от имени вместо
        глифа. Размеры — по таблице ключей: AxIconSize, AxCornerRadiusSmall
        («бейджи, значки типов файлов»), AxFontSizeCaption («бейджи, счётчики»)
        вместо 9px, проставленных в карточке мимо шкалы. Своего контрола под
        плашку проект не заводит — поэтому она собрана здесь, в витрине.
    -->
    <Style Selector="Border.file-badge">
      <Setter Property="Width" Value="{DynamicResource AxIconSize}"/>
      <Setter Property="Height" Value="{DynamicResource AxIconSize}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusSmall}"/>
      <Setter Property="Background" Value="{DynamicResource AxInfoBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.file-badge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource GalleryFileBadgeBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <!--
      Карточки страницы «20 Контролы» дизайн-проекта, в её порядке. Контрол
      создаётся дважды — в светлой и тёмной половинах окна, — поэтому
      содержимое вынесено в UserControl: правка карточки видна в обеих темах.
      Наведение, нажатие и фокус здесь живые, а не нарисованные: Tab обходит
      карточки с видимым кольцом.
  -->
  <StackPanel Margin="22,18" Spacing="14">

    <!-- Кнопки -->
    <ax:AxGroupHeader Content="Кнопки"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxButton Classes="accent">Button</ax:AxButton>
      <ax:AxButton>Button</ax:AxButton>
      <ax:AxButton Classes="ghost">Button</ax:AxButton>
      <ax:AxButton Classes="danger">Delete</ax:AxButton>
      <ax:AxButton IsEnabled="False">Button</ax:AxButton>
      <ax:AxButton Classes="icon" ToolTip.Tip="Собрать проект">
        <ax:AxIcon Data="{x:Static ax:AxIcons.Plus}"/>
      </ax:AxButton>
    </StackPanel>

    <!-- Компактная кнопка -->
    <ax:AxGroupHeader Content="Компактная кнопка · 24"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxButton Classes="compact">Slim</ax:AxButton>
      <ax:AxButton Classes="compact ghost">Slim</ax:AxButton>
      <ax:AxButton Classes="compact" IsEnabled="False">Slim</ax:AxButton>
    </StackPanel>

    <!-- Кнопка с меню -->
    <ax:AxGroupHeader Content="Кнопка с меню"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxSplitButton Classes="accent" Content="Run">
        <ax:AxSplitButton.Flyout>
          <ax:AxMenuFlyout>
            <MenuItem Header="Run ChatApp"/>
            <MenuItem Header="Run с отладкой"/>
          </ax:AxMenuFlyout>
        </ax:AxSplitButton.Flyout>
      </ax:AxSplitButton>
      <ax:AxSplitButton Content="Run"/>
      <ax:AxSplitButton Content="Run" IsEnabled="False"/>
    </StackPanel>

    <!-- Дропдаун -->
    <ax:AxGroupHeader Content="Дропдаун"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxDropDownButton Content="Debug">
        <ax:AxDropDownButton.Flyout>
          <ax:AxMenuFlyout>
            <MenuItem Header="Debug"/>
            <MenuItem Header="Release"/>
          </ax:AxMenuFlyout>
        </ax:AxDropDownButton.Flyout>
      </ax:AxDropDownButton>
      <ax:AxDropDownButton Content="Debug" IsEnabled="False"/>
    </StackPanel>

    <!-- Чекбокс -->
    <ax:AxGroupHeader Content="Чекбокс"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <ax:AxCheckBox>Unchecked</ax:AxCheckBox>
      <ax:AxCheckBox IsChecked="True">Checked</ax:AxCheckBox>
      <ax:AxCheckBox IsThreeState="True" IsChecked="{x:Null}">Indeterminate</ax:AxCheckBox>
      <ax:AxCheckBox Classes="error">Invalid</ax:AxCheckBox>
      <ax:AxCheckBox IsEnabled="False" IsChecked="True">Disabled</ax:AxCheckBox>
    </StackPanel>

    <!-- Радиокнопка -->
    <ax:AxGroupHeader Content="Радиокнопка"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <ax:AxRadioButton IsChecked="True">On</ax:AxRadioButton>
      <ax:AxRadioButton>Off</ax:AxRadioButton>
      <ax:AxRadioButton IsEnabled="False">Disabled</ax:AxRadioButton>
    </StackPanel>

    <!-- Переключатель -->
    <ax:AxGroupHeader Content="Переключатель · 30×17"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <ax:AxToggleSwitch IsChecked="True" Content="On"/>
      <ax:AxToggleSwitch Content="Off"/>
      <ax:AxToggleSwitch IsChecked="True" IsEnabled="False" Content="Disabled"/>
    </StackPanel>

    <!--
        Поле ввода — карточка «Input Field · с подписью» проекта: пять состояний
        в ряд равными колонками, в колонке подпись состояния, подпись поля и
        само поле.

        Две колонки из пяти показывают фокус, а живое окно даёт один фокус на
        всех — и половин здесь две. Поэтому состояние ставится этим полям прямо,
        тем же псевдоклассом :focus, которым его включает сама тема: карточка
        показывает состояния, а показать состояние значит в него поставить.
        Рисует при этом тема, а не галерея, — своего вида фокуса тут нет.
    -->
    <ax:AxGroupHeader Content="Поле ввода"/>
    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="Default"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox Text="ChatView"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock Classes="dim small" Text="Focused"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox x:Name="FocusedField" Text="ChatView"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock Classes="dim small" Text="Invalid"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox Classes="error" Text="Chat View!"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="6">
        <TextBlock Classes="dim small" Text="Invalid focused"/>
        <TextBlock Text="Имя формы"/>
        <ax:AxTextBox x:Name="InvalidFocusedField" Classes="error" Text="Chat View!"/>
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="6">
        <TextBlock Classes="dim small" Text="Disabled"/>
        <!-- Подпись выключенного поля гаснет вместе с ним: проект даёт AxFg3. -->
        <TextBlock Classes="dimmer" Text="Имя формы"/>
        <ax:AxTextBox IsEnabled="False" Text="ChatView"/>
      </StackPanel>
    </Grid>

    <!--
        Чего карточка проекта не перечисляет, но требует спецификация:
        предупреждение (раздел 10 — класс warning рядом с error), текст ошибки
        под полем (раздел 12 — «класс error плюс текст под полем»), подсказка
        вместо подписи и компактная высота 24 плотной зоны (раздел 6).
    -->
    <StackPanel Spacing="8" Width="360" HorizontalAlignment="Left">
      <ax:AxTextBox PlaceholderText="Плейсхолдер читается вместо подписи"/>
      <StackPanel Spacing="3">
        <ax:AxTextBox Classes="error" Text="Chat View!"/>
        <TextBlock Classes="bad" FontSize="11.5" Text="Имя не может содержать пробелы"/>
      </StackPanel>
      <ax:AxTextBox Classes="warning" Text="chatview"/>
      <ax:AxTextBox Classes="compact" Text="Компактное · 24"/>
    </StackPanel>

    <!--
        Поиск — карточка «Search · поле и строка поиска в редакторе»: поле в
        покое, поле в фокусе с крестиком очистки и строка поиска редактора.

        Строка редактора собрана из готовых контролов: раздел 8 закрепляет за
        «Поиском» только AxSearchField, своего контрола под неё проект не
        заводит, и заводить его здесь значило бы решать за владельца зоны.
    -->
    <ax:AxGroupHeader Content="Поиск"/>
    <StackPanel Spacing="14">
      <!--
          Подписи над строками. Карточка проекта их не рисует — там состояния
          различает сам вид, — но живое поле состояние теряет: стёрли текст
          крестиком, и «в фокусе с текстом» стало неотличимо от «в покое».
          Подпись остаётся, что бы с полем ни делали.
      -->
      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="В покое"/>
        <ax:AxSearchField Width="240" HorizontalAlignment="Left" PlaceholderText="Поиск"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="В фокусе, с очисткой"/>
        <ax:AxSearchField x:Name="FocusedSearch" Width="240" HorizontalAlignment="Left" Text="send"/>
      </StackPanel>

      <!--
          Строка поиска редактора: слева лупа, дальше набранное, справа
          переключатели, счётчик и переходы. Текст здесь настоящий — это поиск,
          в него печатают.
      -->
      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="Строка поиска в редакторе"/>
        <Border Height="32" CornerRadius="6" Padding="10,0"
                Background="{DynamicResource AxBg2Brush}"
                BorderBrush="{DynamicResource AxBrd2Brush}"
                BorderThickness="1">
          <DockPanel LastChildFill="True">
            <ax:AxIcon DockPanel.Dock="Left" Margin="0,0,8,0"
                       Data="{x:Static ax:AxIcons.Search}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <!-- Учитывать регистр включено — своей плашкой; регулярка выключена. -->
              <ax:AxChip Content="Aa" VerticalAlignment="Center"/>
              <TextBlock Classes="dim" Text=".*" VerticalAlignment="Center"/>
              <TextBlock Classes="dim small" Text="3/14" VerticalAlignment="Center"/>
              <ax:AxButton Classes="icon" AutomationProperties.Name="Предыдущее">
                <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.ChevronUp}"/>
              </ax:AxButton>
              <ax:AxButton Classes="icon" AutomationProperties.Name="Следующее">
                <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.ChevronDown}"/>
              </ax:AxButton>
              <ax:AxButton Classes="icon" AutomationProperties.Name="Закрыть поиск">
                <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.Close}"/>
              </ax:AxButton>
            </StackPanel>
            <ax:AxTextBox Theme="{StaticResource AxInlineTextBox}"
                          Text="message" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- Многострочное поле -->
    <ax:AxGroupHeader Content="Многострочное поле"/>
    <ax:AxTextArea Width="360" HorizontalAlignment="Left"
                   PlaceholderText="Описание, заметка, шаблон письма"/>

    <!-- Комбобокс -->
    <ax:AxGroupHeader Content="Комбобокс"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxComboBox Width="170" SelectedIndex="0">
        <ax:AxComboBoxItem>net8.0-desktop</ax:AxComboBoxItem>
        <ax:AxComboBoxItem>net8.0-android</ax:AxComboBoxItem>
        <ax:AxComboBoxItem>net8.0-ios</ax:AxComboBoxItem>
        <ax:AxComboBoxItem>net8.0-browser</ax:AxComboBoxItem>
      </ax:AxComboBox>
      <ax:AxComboBox Classes="compact" Width="150" SelectedIndex="0">
        <ax:AxComboBoxItem>Компактный · 24</ax:AxComboBoxItem>
      </ax:AxComboBox>
      <ax:AxComboBox Width="130" PlaceholderText="Выключен" IsEnabled="False"/>
    </StackPanel>

    <!-- Сегментированный контрол -->
    <ax:AxGroupHeader Content="Сегментированный контрол"/>
    <ax:AxSegmentedControl SelectedIndex="0">
      <ax:AxSegmentItem>Дизайн</ax:AxSegmentItem>
      <ax:AxSegmentItem>XAML</ax:AxSegmentItem>
      <ax:AxSegmentItem>Разделить</ax:AxSegmentItem>
    </ax:AxSegmentedControl>

    <!-- Вкладки -->
    <ax:AxGroupHeader Content="Вкладки"/>
    <!--
        Два ряда, как в карточке проекта: обычные вкладки прозрачной полосой,
        вкладки документа — на своей, со скруглением сверху и крестиками.
    -->
    <ax:AxTabStrip Theme="{StaticResource AxToolWindowTabStrip}" SelectedIndex="0"
                   BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="0,0,0,1">
      <ax:AxTabItem Classes="compact" Content="Свойства" IsClosable="False"/>
      <ax:AxTabItem Classes="compact" Content="События" IsClosable="False"/>
      <ax:AxTabItem Classes="compact" Content="Стили" IsClosable="False"/>
      <ax:AxTabItem Classes="compact" Content="Ресурсы" IsClosable="False"/>
    </ax:AxTabStrip>
    <ax:AxTabStrip SelectedIndex="0">
      <ax:AxTabItem Content="MainWindow.axaml"/>
      <ax:AxTabItem Content="ChatViewModel.cs" IsModified="True"/>
      <ax:AxTabItem Content="App.axaml"/>
    </ax:AxTabStrip>

    <!-- Ссылки -->
    <ax:AxGroupHeader Content="Ссылки"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <ax:AxLink Content="Документация"/>
      <ax:AxLink Content="Документация" IsVisited="True"/>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <ax:AxLink Content="avaloniaui.net"/>
        <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.ExternalLink}"
                   Foreground="{DynamicResource AxLinkBrush}" VerticalAlignment="Center"/>
      </StackPanel>
      <ax:AxLink Content="Документация" IsEnabled="False"/>
    </StackPanel>

    <!-- Баннеры -->
    <ax:AxGroupHeader Content="Баннеры"/>
    <StackPanel Spacing="8">
      <ax:AxBanner Severity="Information"
                   Content="Доступно обновление Arxis SDK 1.4.2 — новые контролы Avalonia.">
        <ax:AxBanner.Actions>
          <ax:AxLink Content="Обновить"/>
        </ax:AxBanner.Actions>
      </ax:AxBanner>
      <ax:AxBanner Severity="Success"
                   Content="Проект ChatApp успешно собран — 0 ошибок, 0 предупреждений."/>
      <ax:AxBanner Severity="Warning"
                   Content="Не выбран стартовый проект. Запуск недоступен.">
        <ax:AxBanner.Actions>
          <ax:AxLink Content="Выбрать"/>
        </ax:AxBanner.Actions>
      </ax:AxBanner>
      <ax:AxBanner Severity="Error"
                   Content="Ошибка привязки: свойство «UserName» не найдено в ChatViewModel.">
        <ax:AxBanner.Actions>
          <ax:AxLink Content="Показать"/>
        </ax:AxBanner.Actions>
      </ax:AxBanner>
    </StackPanel>

    <!-- Уведомления -->
    <ax:AxGroupHeader Content="Уведомления"/>
    <ax:AxNotificationCard Severity="Success"
                           Title="Сборка завершена"
                           Content="ChatApp собран за 2,4 с. Готов к запуску на net8.0-desktop."
                           HorizontalAlignment="Left">
      <ax:AxNotificationCard.Actions>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <ax:AxLink Content="Запустить"/>
          <ax:AxLink Content="Показать журнал"/>
        </StackPanel>
      </ax:AxNotificationCard.Actions>
    </ax:AxNotificationCard>

    <!-- Диалоги -->
    <ax:AxGroupHeader Content="Диалоги"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxButton Click="OnOpenDialog">Сохранить изменения?</ax:AxButton>
      <ax:AxButton Click="OnOpenDangerDialog">Удалить форму…</ax:AxButton>
    </StackPanel>

    <!-- Тултипы -->
    <ax:AxGroupHeader Content="Тултипы"/>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ax:AxButton ToolTip.Tip="Собрать проект">Наведи и подожди</ax:AxButton>
      <ax:AxButton>
        <ToolTip.Tip>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Собрать проект"/>
            <TextBlock Classes="dim" Text="⌘ F9"/>
          </StackPanel>
        </ToolTip.Tip>
        С шорткатом
      </ax:AxButton>
    </StackPanel>
    <ax:AxTeachingTip Title="Быстрый предпросмотр"
                      StepText="1/3"
                      HorizontalAlignment="Left"
                      Content="Нажмите ⌘P, чтобы открыть форму в живом режиме без сборки.">
      <ax:AxTeachingTip.Actions>
        <ax:AxButton Classes="compact">Понятно</ax:AxButton>
      </ax:AxTeachingTip.Actions>
    </ax:AxTeachingTip>

    <!-- Прогресс-бар -->
    <ax:AxGroupHeader Content="Прогресс-бар"/>
    <StackPanel Spacing="8" Width="360" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="dim" FontSize="11.5" Text="Сборка ChatApp"/>
        <ax:AxProgressBar Minimum="0" Maximum="100" Value="64"/>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="dim" FontSize="11.5" Text="Индексация проекта…"/>
        <ax:AxProgressBar IsIndeterminate="True"/>
      </StackPanel>
    </StackPanel>

    <!-- Лоадер -->
    <ax:AxGroupHeader Content="Лоадер"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ax:AxSpinner/>
      <TextBlock Classes="dim" VerticalAlignment="Center" Text="Индексация…"/>
    </StackPanel>

    <!-- Контекстное меню -->
    <ax:AxGroupHeader Content="Контекстное меню"/>
    <ax:AxButton x:Name="MenuAnchor" HorizontalAlignment="Left" Click="OnOpenMenu">Открыть меню</ax:AxButton>

    <!-- Попап со списком -->
    <ax:AxGroupHeader Content="Попап поиска"/>
    <ax:AxQuickSearch x:Name="QuickSearch"
                      HorizontalAlignment="Left"
                      Text="chat"
                      SelectedItem="ChatView.axaml · Views"
                      PlaceholderText="Класс, файл, символ"
                      Hints="↑↓ выбор · ↵ открыть · esc"/>

    <!-- Дерево -->
    <ax:AxGroupHeader Content="Дерево"/>
    <!--
        Дерево проекта: у папок глиф, у файлов плашка типа — так его рисует
        карточка проекта. Выбрана строка ChatView.axaml, как в макете.
    -->
    <ax:AxTreeView SelectedItem="{Binding #SelectedFile}">
      <ax:AxTreeViewItem Header="ChatApp" IsExpanded="True">
        <ax:AxTreeViewItem.Icon>
          <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
        </ax:AxTreeViewItem.Icon>
        <ax:AxTreeViewItem Header="Views" IsExpanded="True">
          <ax:AxTreeViewItem.Icon>
            <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
          </ax:AxTreeViewItem.Icon>
          <ax:AxTreeViewItem x:Name="SelectedFile" Header="ChatView.axaml">
            <ax:AxTreeViewItem.Icon>
              <Border Classes="file-badge"><TextBlock Text="Ax"/></Border>
            </ax:AxTreeViewItem.Icon>
          </ax:AxTreeViewItem>
          <ax:AxTreeViewItem Header="MainWindow.axaml">
            <ax:AxTreeViewItem.Icon>
              <Border Classes="file-badge"><TextBlock Text="Ax"/></Border>
            </ax:AxTreeViewItem.Icon>
          </ax:AxTreeViewItem>
        </ax:AxTreeViewItem>
        <ax:AxTreeViewItem Header="ViewModels">
          <ax:AxTreeViewItem.Icon>
            <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
          </ax:AxTreeViewItem.Icon>
          <ax:AxTreeViewItem Header="ChatViewModel.cs"/>
        </ax:AxTreeViewItem>
        <ax:AxTreeViewItem Header="App.axaml">
          <ax:AxTreeViewItem.Icon>
            <Border Classes="file-badge"><TextBlock Text="Ax"/></Border>
          </ax:AxTreeViewItem.Icon>
        </ax:AxTreeViewItem>
      </ax:AxTreeViewItem>
    </ax:AxTreeView>

    <!-- Список: та же строка 24, что и в дереве, но без отступов уровня -->
    <ax:AxGroupHeader Content="Список"/>
    <ax:AxListBox Width="260" HorizontalAlignment="Left" SelectedIndex="1">
      <ax:AxListBoxItem Content="MainWindow.axaml"/>
      <ax:AxListBoxItem Content="ChatView.axaml"/>
      <ax:AxListBoxItem Content="LoginView.axaml"/>
      <ax:AxListBoxItem Content="SettingsView.axaml" IsEnabled="False"/>
    </ax:AxListBox>

    <!-- Таблица -->
    <ax:AxGroupHeader Content="Таблица"/>
    <!--
        Колонки долевые, как в карточке: 2fr 1fr 1fr 1fr. Ширины таблице не
        задаём — в карточке она занимает всю половину.
    -->
    <ax:AxDataGrid SelectedIndex="1">
      <ax:AxDataGrid.Header>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="Форма"/>
          <TextBlock Grid.Column="1" Text="Контролов"/>
          <TextBlock Grid.Column="2" Text="Изменена"/>
          <TextBlock Grid.Column="3" Text="Статус"/>
        </Grid>
      </ax:AxDataGrid.Header>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="MainWindow.axaml"/>
          <TextBlock Grid.Column="1" Text="12"/>
          <TextBlock Grid.Column="2" Text="сегодня 14:02"/>
          <TextBlock Grid.Column="3" Classes="ok" Text="Собрана"/>
        </Grid>
      </ax:AxListBoxItem>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="ChatView.axaml"/>
          <TextBlock Grid.Column="1" Text="23"/>
          <TextBlock Grid.Column="2" Text="сегодня 14:21"/>
          <TextBlock Grid.Column="3" Classes="ok" Text="Собрана"/>
        </Grid>
      </ax:AxListBoxItem>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="LoginView.axaml"/>
          <TextBlock Grid.Column="1" Text="9"/>
          <TextBlock Grid.Column="2" Text="вчера 18:47"/>
          <TextBlock Grid.Column="3" Classes="bad" Text="Ошибка привязки"/>
        </Grid>
      </ax:AxListBoxItem>
      <ax:AxListBoxItem>
        <Grid ColumnDefinitions="2*,*,*,*">
          <TextBlock Text="SettingsView.axaml"/>
          <TextBlock Grid.Column="1" Text="17"/>
          <TextBlock Grid.Column="2" Text="12 авг"/>
          <TextBlock Grid.Column="3" Classes="dim" Text="Черновик"/>
        </Grid>
      </ax:AxListBoxItem>
    </ax:AxDataGrid>

    <!-- Тулбар -->
    <ax:AxGroupHeader Content="Тулбар"/>
    <ax:AxToolBar>
      <ax:AxToolBar.LeftContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ax:AxButton Classes="icon" ToolTip.Tip="Отменить">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Undo}"/>
          </ax:AxButton>
          <ax:AxButton Classes="icon" ToolTip.Tip="Вернуть">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Redo}"/>
          </ax:AxButton>
          <ax:AxButton Classes="icon" IsEnabled="False">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Refresh}"/>
          </ax:AxButton>
        </StackPanel>
      </ax:AxToolBar.LeftContent>
      <ax:AxToolBar.CenterContent>
        <ax:AxDropDownButton Content="ВолнаЧат.Desktop"/>
      </ax:AxToolBar.CenterContent>
      <ax:AxToolBar.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ax:AxButton Classes="icon">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Play}" IsFilled="True"
                       Foreground="{DynamicResource AxGrnBrush}"/>
          </ax:AxButton>
          <ax:AxButton Classes="icon">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Debug}"/>
          </ax:AxButton>
        </StackPanel>
      </ax:AxToolBar.RightContent>
    </ax:AxToolBar>

    <!--
        Тулбар окна: в Int UI отдельного системного заголовка у главного окна
        нет — строка с проектом и есть заголовок.

        Кнопки окна тут стоят отдельным AxWindowControls и не принимают
        нажатий: свои кнопки полоса вешает на то окно, в котором стоит, и в
        галерее «закрыть» закрыло бы саму галерею. Карточка показывает вид,
        а не поведение.
    -->
    <ax:AxGroupHeader Content="Тулбар окна"/>
    <ax:AxTitleBar Width="520" HorizontalAlignment="Left" ShowWindowControls="False">
      <DockPanel Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ax:AxIcon Data="{x:Static ax:AxIcons.Window}"/>
          <TextBlock Text="ВолнаЧат" VerticalAlignment="Center"/>
          <ax:AxChip Content="Debug"/>
        </StackPanel>
        <ax:AxWindowControls DockPanel.Dock="Right" IsHitTestVisible="False"/>
        <Panel/>
      </DockPanel>
    </ax:AxTitleBar>

    <!-- Хлебные крошки -->
    <ax:AxGroupHeader Content="Хлебные крошки"/>
    <!--
        Четыре ряда карточки проекта, в её порядке и с её подписями.
    -->
    <StackPanel Spacing="18">
      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="Путь к файлу"/>
        <ax:AxBreadcrumbBar>
          <ax:AxBreadcrumbItem Content="ВолнаЧат">
            <ax:AxBreadcrumbItem.Icon>
              <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
            </ax:AxBreadcrumbItem.Icon>
          </ax:AxBreadcrumbItem>
          <!-- Звено под курсором: в карточке оно показано с плашкой. -->
          <ax:AxBreadcrumbItem x:Name="HoveredCrumb" Content="Views">
            <ax:AxBreadcrumbItem.Icon>
              <ax:AxIcon Data="{x:Static ax:AxIcons.Folder}"/>
            </ax:AxBreadcrumbItem.Icon>
          </ax:AxBreadcrumbItem>
          <ax:AxBreadcrumbItem Classes="current" Content="ChatView.axaml">
            <ax:AxBreadcrumbItem.Icon>
              <Border Classes="file-badge"><TextBlock Text="Ax"/></Border>
            </ax:AxBreadcrumbItem.Icon>
          </ax:AxBreadcrumbItem>
        </ax:AxBreadcrumbBar>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="С выпадающим списком и усечением"/>
        <ax:AxBreadcrumbBar>
          <ax:AxBreadcrumbItem>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="ВолнаЧат" VerticalAlignment="Center"/>
              <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.ChevronDown}"
                         Foreground="{DynamicResource AxFg2Brush}"/>
            </StackPanel>
          </ax:AxBreadcrumbItem>
          <ax:AxBreadcrumbItem Content="…"/>
          <ax:AxBreadcrumbItem>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Views" VerticalAlignment="Center"/>
              <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.ChevronDown}"
                         Foreground="{DynamicResource AxFg2Brush}"/>
            </StackPanel>
          </ax:AxBreadcrumbItem>
          <ax:AxBreadcrumbItem Classes="current">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="ChatView.axaml" VerticalAlignment="Center"/>
              <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.ChevronDown}"
                         Foreground="{DynamicResource AxFg2Brush}"/>
            </StackPanel>
          </ax:AxBreadcrumbItem>
        </ax:AxBreadcrumbBar>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="Дерево контролов в дизайнере"/>
        <ax:AxBreadcrumbBar Classes="framed" HorizontalAlignment="Left">
          <ax:AxBreadcrumbItem Content="Window">
            <ax:AxBreadcrumbItem.Icon>
              <!--
                  Скобки: этот глиф нарисован в карточке крошек, но зона иконок
                  его не публикует — в AxIcons его нет и завести нельзя, набор
                  сверяется с зоной один в один. Пока рисуем здесь, по правилам
                  набора: клетка 16, обводка 1.2.
              -->
              <ax:AxIcon Data="M6.5 3H5.5A1.5 1.5 0 0 0 4 4.5v2A1.5 1.5 0 0 1 2.5 8A1.5 1.5 0 0 1 4 9.5v2A1.5 1.5 0 0 0 5.5 13h1 M9.5 3h1A1.5 1.5 0 0 1 12 4.5v2A1.5 1.5 0 0 0 13.5 8A1.5 1.5 0 0 0 12 9.5v2A1.5 1.5 0 0 1 10.5 13h-1"/>
            </ax:AxBreadcrumbItem.Icon>
          </ax:AxBreadcrumbItem>
          <ax:AxBreadcrumbItem Content="Grid"/>
          <ax:AxBreadcrumbItem Content="StackPanel"/>
          <ax:AxBreadcrumbItem Classes="current" Content="SendButton"/>
        </ax:AxBreadcrumbBar>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="dim small" Text="Ошибка в пути и неактивные звенья"/>
        <ax:AxBreadcrumbBar>
          <ax:AxBreadcrumbItem IsEnabled="False" Content="ВолнаЧат"/>
          <ax:AxBreadcrumbItem IsEnabled="False" Content="Views"/>
          <ax:AxBreadcrumbItem Classes="error" Content="LoginView.axaml"/>
        </ax:AxBreadcrumbBar>
      </StackPanel>
    </StackPanel>

    <!-- Tool Window -->
    <ax:AxGroupHeader Content="Tool Window"/>
    <!--
        Три вида шапки рядом, как в карточке: только заголовок, заголовок с
        линией, заголовок с вкладками. Панели пустые — карточка показывает
        именно шапку, а содержимое там ничем не занято.
    -->
    <!--
        Правило карточки — колонки делят строку поровну и переносятся, когда
        каждой остаётся меньше 250. На половине витрины в 736 три колонки дали
        бы по 232, поэтому их две, и третья панель встаёт на вторую строку.
        Отбивка 20 висит на самих колонках, а отрицательное поле сетки убирает
        её с внешних краёв.
    -->
    <UniformGrid Columns="2" Margin="0,0,-20,-20">
      <StackPanel Spacing="8" Margin="0,0,20,20">
        <TextBlock Classes="dim small" Text="Label only"/>
        <ax:AxToolWindow Title="Header" Height="150" ShowHeaderSeparator="False">
          <ax:AxToolWindow.Actions>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton Classes="icon">
                <ax:AxIcon Data="{x:Static ax:AxIcons.MoreVertical}" IsFilled="True"/>
              </ax:AxButton>
              <ax:AxButton Classes="icon">
                <ax:AxIcon Data="{x:Static ax:AxIcons.Minus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Actions>
        </ax:AxToolWindow>
      </StackPanel>

      <StackPanel Spacing="8" Margin="0,0,20,20">
        <TextBlock Classes="dim small" Text="Label with separator"/>
        <ax:AxToolWindow Title="Header" Height="150" ShowHeaderSeparator="True">
          <ax:AxToolWindow.Actions>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton Classes="icon">
                <ax:AxIcon Data="{x:Static ax:AxIcons.MoreVertical}" IsFilled="True"/>
              </ax:AxButton>
              <ax:AxButton Classes="icon">
                <ax:AxIcon Data="{x:Static ax:AxIcons.Minus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Actions>
        </ax:AxToolWindow>
      </StackPanel>

      <StackPanel Spacing="8" Margin="0,0,20,20">
        <TextBlock Classes="dim small" Text="Tabs"/>
        <ax:AxToolWindow Title="Header" Height="150" ShowHeaderSeparator="True">
          <ax:AxToolWindow.Tabs>
            <StackPanel Orientation="Horizontal">
              <ax:AxTabStrip Theme="{StaticResource AxToolWindowTabStrip}" SelectedIndex="0">
                <ax:AxTabItem Content="Text"/>
                <ax:AxTabItem Content="Text"/>
              </ax:AxTabStrip>
              <!-- Добавить вкладку: в карточке кнопка стоит в ряду вкладок. -->
              <ax:AxButton Classes="icon" VerticalAlignment="Center">
                <ax:AxIcon Data="{x:Static ax:AxIcons.Plus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Tabs>
          <ax:AxToolWindow.Actions>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ax:AxButton Classes="icon">
                <ax:AxIcon Data="{x:Static ax:AxIcons.MoreVertical}" IsFilled="True"/>
              </ax:AxButton>
              <ax:AxButton Classes="icon">
                <ax:AxIcon Data="{x:Static ax:AxIcons.Minus}"/>
              </ax:AxButton>
            </StackPanel>
          </ax:AxToolWindow.Actions>
        </ax:AxToolWindow>
      </StackPanel>
    </UniformGrid>

    <!-- Скроллбар -->
    <ax:AxGroupHeader Content="Скроллбар · 8"/>
    <Border BorderBrush="{DynamicResource AxBrdBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource AxCornerRadius}"
            Height="90" Width="360" HorizontalAlignment="Left">
      <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="10">
          <TextBlock Text="Строка 1"/><TextBlock Text="Строка 2"/><TextBlock Text="Строка 3"/>
          <TextBlock Text="Строка 4"/><TextBlock Text="Строка 5"/><TextBlock Text="Строка 6"/>
          <TextBlock Text="Строка 7"/><TextBlock Text="Строка 8"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Шорткаты и код -->
    <ax:AxGroupHeader Content="Шорткаты и код"/>
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ax:AxChip Classes="kbd">Shift</ax:AxChip>
      <ax:AxChip Classes="kbd">F10</ax:AxChip>
      <ax:AxChip>метка</ax:AxChip>
      <ax:AxChip Classes="accent">выбранная</ax:AxChip>
      <ax:AxBadge>7</ax:AxBadge>
    </StackPanel>
    <ax:AxCodeBlock x:Name="Code" Width="440" HorizontalAlignment="Left"/>

    <!-- Заголовок группы -->
    <ax:AxGroupHeader Content="Заголовок группы"/>
    <StackPanel Spacing="8">
      <ax:AxGroupHeader Content="Внешний вид"/>
      <ax:AxGroupHeader Content="Привязки"/>
    </StackPanel>

    <!-- Разделители: линия в пиксель, обе ориентации -->
    <ax:AxGroupHeader Content="Разделители"/>
    <StackPanel Spacing="10">
      <ax:AxDivider Width="260" HorizontalAlignment="Left"/>
      <StackPanel Orientation="Horizontal" Spacing="10" Height="20">
        <TextBlock Classes="dim" Text="слева" VerticalAlignment="Center"/>
        <ax:AxDivider Orientation="Vertical"/>
        <TextBlock Classes="dim" Text="справа" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <!-- Примитивы M0, которых нет на странице карточками -->
    <ax:AxGroupHeader Content="Примитивы"/>
    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
      <ax:AxAvatar Initials="ВЧ"/>
      <ax:AxSlider Width="140" Minimum="0" Maximum="100" Value="60"/>
      <ax:AxDivider Orientation="Vertical" Height="20"/>
      <ax:AxCard Padding="10">
        <TextBlock Classes="dim" FontSize="11.5" Text="Карточка"/>
      </ax:AxCard>
    </StackPanel>

  </StackPanel>
</UserControl>
